# ── Contracts (Hardhat) ───────────────────────────────────────────────
# RPC URL for deploying to Sepolia
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Deployer wallet private key (never commit a real key)
PRIVATE_KEY=your_deployer_wallet_private_key

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# ── Frontend (Vite) ───────────────────────────────────────────────────
# Deployed ImpactFundFactory address on Sepolia
VITE_FACTORY_ADDRESS=0x6A837595E2592d699d48eB2DAcF47Df9493035d2

# Sepolia block explorer base URL
VITE_BLOCK_EXPLORER_URL=https://sepolia.etherscan.io

# Read-only RPC for the frontend (used when no wallet is connected)
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# WalletConnect project ID (get one free at https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
